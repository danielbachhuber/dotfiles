  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harvest:sync": "rm -rf node_modules/bb-plugin-harvest && npm install --install-links file:../../../../projects/harvest-bb-plugin"
  },
  "dependencies": {
    "@danielb/gh-shared": "file:../gh-shared",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "bb-plugin-harvest": "file:../../../../projects/harvest-bb-plugin",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.5",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
