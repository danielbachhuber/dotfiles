{
  "name": "bb-plugin-issue-sweep",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Issue Sweep",
    "description": "Open GitHub issues assigned to you, newest activity first.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
