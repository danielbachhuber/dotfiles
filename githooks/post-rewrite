#!/bin/bash
#
# The rebase counterpart to post-merge: `git pull --rebase` rewrites commits
# instead of merging, so post-merge never fires.
#
# Git also calls this after `git commit --amend`, where nothing was pulled and
# there is nothing to sync.

[ "$1" = "rebase" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
exec "$root/githooks/post-merge"
