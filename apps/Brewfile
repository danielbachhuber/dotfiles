# Packages and applications installed on this machine.
#
# Curated by hand, not produced by `brew bundle dump`. A dump writes every
# installed formula including transitive dependencies, so the file churns
# whenever a dependency shifts and stops recording what was actually chosen.
# Only roots belong here: `ffmpeg`, `pytorch`, and `numpy` arrive with
# openai-whisper, `deno` with yt-dlp.
#
# Note that `brew leaves` is not a reliable source for this list. It omits
# formulae from third-party taps, which on this machine hides ghui.
#
# Apply with ./setup.sh, which also installs the npm globals and agent CLIs.
# Report on it with ./check.sh, which changes nothing.

# --- Taps --------------------------------------------------------------------
# Homebrew 6 refuses to load a formula from an untrusted third-party tap, and
# there is no Brewfile directive for trusting one. setup.sh runs `brew trust`
# before `brew bundle` for this reason.
tap "kitlangton/tap"   # ghui

# --- Command line ------------------------------------------------------------
brew "autojump"
brew "gh"
brew "ghostscript"
brew "ghui"
brew "googleworkspace-cli"
brew "hugo"
brew "llm"
brew "mas"                       # drives the App Store section below
brew "mprocs"
brew "openai-whisper"
brew "pyenv"
brew "qrtool"
brew "ripgrep"
brew "the_silver_searcher"
brew "tig"
brew "wget"
brew "yt-dlp"

